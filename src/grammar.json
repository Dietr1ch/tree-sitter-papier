{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "papier",
  "rules": {
    "papier": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "SYMBOL",
              "name": "sub_document"
            }
          },
          {
            "type": "SYMBOL",
            "name": "text"
          }
        ]
      }
    },
    "text": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "line"
        }
      }
    },
    "line": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "REPEAT1",
              "content": {
                "type": "SYMBOL",
                "name": "word"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "\\n"
        }
      ]
    },
    "word": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "uuid"
            },
            {
              "type": "SYMBOL",
              "name": "alias"
            },
            {
              "type": "SYMBOL",
              "name": "ref"
            },
            {
              "type": "SYMBOL",
              "name": "tag"
            },
            {
              "type": "SYMBOL",
              "name": "fmt"
            },
            {
              "type": "PATTERN",
              "value": "[^ \\t\\n]+"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[.,;:!?]"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "uuid": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "!"
            },
            {
              "type": "FIELD",
              "name": "uuid",
              "content": {
                "type": "PATTERN",
                "value": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            }
          ]
        }
      }
    },
    "alias": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "!!"
            },
            {
              "type": "FIELD",
              "name": "alias",
              "content": {
                "type": "PATTERN",
                "value": "[a-zA-Z][-_a-zA-Z0-9]*"
              }
            }
          ]
        }
      }
    },
    "ref": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "!?"
            },
            {
              "type": "FIELD",
              "name": "ref",
              "content": {
                "type": "PATTERN",
                "value": "[^ \\t\\n]+"
              }
            }
          ]
        }
      }
    },
    "tag": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "#"
            },
            {
              "type": "FIELD",
              "name": "tag",
              "content": {
                "type": "PATTERN",
                "value": "(?i)[a-z0-9][-_a-z0-9]*"
              }
            }
          ]
        }
      }
    },
    "fmt": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "@"
            },
            {
              "type": "FIELD",
              "name": "format",
              "content": {
                "type": "PATTERN",
                "value": "[a-z][-_a-z0-9]*"
              }
            }
          ]
        }
      }
    },
    "sub_document": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "doc_start"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "title",
                "content": {
                  "type": "SYMBOL",
                  "name": "title"
                }
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "FIELD",
                    "name": "opening_brace",
                    "content": {
                      "type": "STRING",
                      "value": "{"
                    }
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\n"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "FIELD",
                        "name": "contents",
                        "content": {
                          "type": "SYMBOL",
                          "name": "contents"
                        }
                      },
                      {
                        "type": "BLANK"
                      }
                    ]
                  },
                  {
                    "type": "FIELD",
                    "name": "closing_brace",
                    "content": {
                      "type": "STRING",
                      "value": "}"
                    }
                  }
                ]
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "FIELD",
                    "name": "opening_brace",
                    "content": {
                      "type": "STRING",
                      "value": "!EoF{"
                    }
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\n"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "FIELD",
                        "name": "contents",
                        "content": {
                          "type": "SYMBOL",
                          "name": "raw_contents"
                        }
                      },
                      {
                        "type": "BLANK"
                      }
                    ]
                  },
                  {
                    "type": "FIELD",
                    "name": "closing_brace",
                    "content": {
                      "type": "STRING",
                      "value": "}EoF!"
                    }
                  }
                ]
              },
              {
                "type": "PATTERN",
                "value": "\\n"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "\\n"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "title": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "word"
      }
    },
    "contents": {
      "type": "REPEAT1",
      "content": {
        "type": "FIELD",
        "name": "line",
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "\\t"
                    },
                    {
                      "type": "PATTERN",
                      "value": "[^\\n]+"
                    }
                  ]
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "PATTERN",
              "value": "\\n"
            }
          ]
        }
      }
    },
    "raw_contents": {
      "type": "REPEAT1",
      "content": {
        "type": "FIELD",
        "name": "line",
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\\n]+"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "PATTERN",
              "value": "\\n"
            }
          ]
        }
      }
    }
  },
  "extras": [
    {
      "type": "STRING",
      "value": " "
    },
    {
      "type": "STRING",
      "value": "\r"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "doc_start"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}